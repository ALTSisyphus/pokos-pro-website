---
/**
 * Главная страница сайта «Покос ПРО».
 *
 * Композиция повторяет логику референса:
 * - крупный split hero;
 * - услуги одной модульной строкой;
 * - асимметричный блок преимуществ;
 * - парные блоки «Работы / Цены», «География / FAQ», «Статьи / CTA».
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Benefits from '../components/home/Benefits.astro';
import WorksPreview from '../components/home/WorksPreview.astro';
import Pricing from '../components/home/Pricing.astro';
import ServiceArea from '../components/home/ServiceArea.astro';
import FAQ from '../components/home/FAQ.astro';
import BlogPreview from '../components/home/BlogPreview.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
---

<BaseLayout
  title="Покос ПРО — покос травы и расчистка участков"
  description="Покос травы, работа с высокой растительностью и расчистка дачных и загородных участков."
>
  <Header />

  <main id="main-content" tabindex="-1">
    <Hero />
    <Services />
    <Benefits />

    <div class="container home-split home-split--works">
      <WorksPreview />
      <Pricing />
    </div>

    <div class="container home-split home-split--area">
      <ServiceArea />
      <FAQ />
    </div>

    <div class="container home-split home-split--bottom">
      <BlogPreview />
      <FinalCTA />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .home-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .home-split > section {
    min-width: 0;
  }

  .home-split > section + section {
    border-left: 1px solid var(--color-border);
  }

  .home-split--bottom {
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .home-split {
      grid-template-columns: 1fr;
    }

    .home-split > section + section {
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }
  }
</style>
