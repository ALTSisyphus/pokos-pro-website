---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Benefits from '../components/home/Benefits.astro';
import WorksPreview from '../components/home/WorksPreview.astro';
import Pricing from '../components/home/Pricing.astro';
import ServiceArea from '../components/home/ServiceArea.astro';
import FAQ from '../components/home/FAQ.astro';
import BlogPreview from '../components/home/BlogPreview.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
---

<BaseLayout
  title="Покос ПРО — покос травы и расчистка участков"
  description="Покос травы, работа с высокой растительностью и расчистка дачных и загородных участков в Москве и Московской области."
>
  <Header />

  <main id="main-content" tabindex="-1">
    <Hero />
    <Services />
    <Benefits />

    <div class="container home-split">
      <WorksPreview />
      <Pricing />
    </div>

    <div class="container home-split">
      <ServiceArea />
      <FAQ />
    </div>

    <div class="container home-split">
      <BlogPreview />
      <FinalCTA />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .home-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .home-split > :global(section) {
    min-width: 0;
  }

  .home-split > :global(section + section) {
    border-left: 1px solid var(--color-line);
  }

  @media (max-width: 920px) {
    .home-split {
      grid-template-columns: 1fr;
    }

    .home-split > :global(section + section) {
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }
  }

  @media (max-width: 620px) {
    .home-split {
      width: 100%;
      border-right: 0;
      border-left: 0;
    }
  }
</style>
