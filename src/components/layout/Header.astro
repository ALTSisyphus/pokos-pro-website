---
/**
 * Шапка сайта.
 *
 * Назначение:
 * - отображать название компании;
 * - предоставлять основную навигацию по странице;
 * - обеспечивать быстрый переход к ключевым разделам сайта.
 *
 * Компонент предназначен для повторного использования
 * на страницах сайта.
 */

const navigation = [
  {
    href: '/#services',
    label: 'Услуги',
  },
  {
    href: '/#advantages',
    label: 'Преимущества',
  },
  {
    href: '/#works',
    label: 'Работы',
  },
  {
    href: '/#prices',
    label: 'Цены',
  },
  {
    href: '/#contacts',
    label: 'Контакты',
  },
] as const;
---

<header class="site-header">
  <div class="container">
    <nav
      class="site-header__nav"
      aria-label="Основная навигация"
    >
      <!-- Логотип / название компании -->
      <a
        class="site-header__brand"
        href="/"
        aria-label="Покос ПРО — главная страница"
      >
        <span
          class="site-header__brand-mark"
          aria-hidden="true"
        ></span>

        <span class="site-header__brand-copy">
          <span class="site-header__brand-name">
            Покос <strong>ПРО</strong>
          </span>

          <span class="site-header__brand-description">
            Уход за участками
          </span>
        </span>
      </a>

      <!-- Навигация для больших экранов -->
      <div class="site-header__desktop">
        <ul
          class="site-header__links"
          role="list"
        >
          {
            navigation.map((item) => (
              <li>
                <a href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          class="button button--primary site-header__cta"
          href="/#contacts"
        >
          Оставить заявку
        </a>
      </div>

      <!-- Навигация для мобильных устройств -->
      <details class="site-header__menu">
        <summary>
          <span>Меню</span>

          <span
            class="site-header__menu-icon"
            aria-hidden="true"
          ></span>
        </summary>

        <div class="site-header__menu-panel">
          <ul
            class="site-header__menu-links"
            role="list"
          >
            {
              navigation.map((item) => (
                <li>
                  <a href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <a
            class="button button--primary"
            href="/#contacts"
          >
            Оставить заявку
          </a>
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  const mobileMenus =
    document.querySelectorAll<HTMLDetailsElement>('.site-header__menu');

  mobileMenus.forEach((menu) => {
    const summary = menu.querySelector('summary');
    const links = menu.querySelectorAll('a');
    const closeMenu = () => menu.removeAttribute('open');

    links.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('click', (event) => {
      if (
        menu.open &&
        event.target instanceof Node &&
        !menu.contains(event.target)
      ) {
        closeMenu();
      }
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        closeMenu();
        summary?.focus();
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;

    z-index: var(--z-header);

    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .site-header__nav {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);

    min-height: var(--header-height);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);

    flex-shrink: 0;

    min-height: 48px;

    color: var(--color-heading);

    text-decoration: none;
  }

  .site-header__brand-mark {
    position: relative;

    display: block;
    flex: 0 0 auto;

    width: 36px;
    height: 36px;

    overflow: hidden;

    background: var(--color-primary);
  }

  .site-header__brand-mark::before,
  .site-header__brand-mark::after {
    position: absolute;
    right: -4px;

    width: 30px;
    height: 2px;

    background: var(--color-white);

    content: '';

    transform: rotate(-32deg);
    transform-origin: right center;
  }

  .site-header__brand-mark::before {
    top: 10px;
  }

  .site-header__brand-mark::after {
    top: 20px;
  }

  .site-header__brand-copy {
    display: grid;
    gap: 3px;
  }

  .site-header__brand-name {
    display: flex;
    align-items: baseline;
    gap: 0.35em;

    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: var(--font-weight-bold);
    line-height: 1;

    letter-spacing: -0.035em;
  }

  .site-header__brand-name strong {
    color: var(--color-primary);
  }

  .site-header__brand-description {
    color: var(--color-text-muted);

    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    line-height: 1;

    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-header__desktop {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-6), 3vw, var(--space-12));
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-1), 1vw, var(--space-4));
  }

  .site-header__links a {
    position: relative;

    display: inline-flex;
    align-items: center;

    min-height: 44px;

    padding-inline: var(--space-3);

    color: var(--color-heading);

    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);

    text-decoration: none;
  }

  .site-header__links a::after {
    position: absolute;
    right: var(--space-3);
    bottom: 0;
    left: var(--space-3);

    height: 2px;

    background: var(--color-primary);

    content: '';

    transform: scaleX(0);
    transform-origin: right;

    transition: transform var(--transition-base);
  }

  .site-header__links a:hover {
    color: var(--color-primary);
  }

  .site-header__links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__links a:focus-visible::after {
    transform: scaleX(1);
  }

  .site-header__cta {
    flex-shrink: 0;

    min-height: 44px;

    padding-inline: var(--space-6);
  }

  .site-header__menu {
    display: none;
  }

  .site-header__menu summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);

    min-height: 44px;
    min-width: 100px;

    padding-inline: var(--space-5);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);

    color: var(--color-heading);

    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);

    cursor: pointer;

    list-style: none;
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__menu[open] summary {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .site-header__menu-icon {
    position: relative;

    width: 18px;
    height: 12px;

    border-top: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
  }

  .site-header__menu-icon::after {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;

    height: 2px;

    background: currentColor;

    content: '';

    transform: translateY(-50%);
  }

  .site-header__menu[open] .site-header__menu-icon {
    border-color: transparent;
  }

  .site-header__menu[open] .site-header__menu-icon::before,
  .site-header__menu[open] .site-header__menu-icon::after {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;

    height: 2px;

    background: currentColor;

    content: '';
  }

  .site-header__menu[open] .site-header__menu-icon::before {
    transform: rotate(45deg);
  }

  .site-header__menu[open] .site-header__menu-icon::after {
    transform: rotate(-45deg);
  }

  .site-header__menu-panel {
    position: absolute;
    top: calc(100% + 1px);
    right: 0;

    display: grid;
    gap: var(--space-6);

    width: min(
      360px,
      calc(100vw - (var(--container-padding) * 2))
    );

    padding: var(--space-6);

    border: 1px solid var(--color-border);
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);

    background: var(--color-white);

    box-shadow: var(--shadow-sm);
  }

  .site-header__menu-links {
    display: grid;
  }

  .site-header__menu-links a {
    display: flex;
    align-items: center;

    min-height: 48px;

    padding-inline: var(--space-2);

    border-bottom: 1px solid var(--color-border);

    color: var(--color-heading);

    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);

    text-decoration: none;
  }

  .site-header__menu-links a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 1050px) {
    .site-header__desktop {
      display: none;
    }

    .site-header__menu {
      display: block;
    }
  }

  @media (max-width: 520px) {
    .site-header__brand-mark {
      width: 32px;
      height: 32px;
    }

    .site-header__brand-name {
      font-size: 1.075rem;
    }

    .site-header__brand-description {
      display: none;
    }

    .site-header__menu-panel {
      gap: var(--space-5);

      padding: var(--space-5);
    }
  }
</style>
