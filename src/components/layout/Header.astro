---
const navigation = [
  { href: '/#services', label: 'Услуги' },
  { href: '/#advantages', label: 'Преимущества' },
  { href: '/#works', label: 'Работы' },
  { href: '/#prices', label: 'Цены' },
  { href: '/#service-area', label: 'Где работаем' },
  { href: '/#articles', label: 'Статьи' },
  { href: '/#contacts', label: 'Контакты' },
] as const;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Покос ПРО — главная">
      <span class="site-header__brand-name">Покос <strong>ПРО</strong></span>
      <span class="site-header__brand-note">Профессиональный<br />покос и расчистка</span>
    </a>

    <nav class="site-header__desktop" aria-label="Основная навигация">
      <ul class="site-header__links" role="list">
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>

      <a class="button button--acid site-header__cta" href="/#contacts">
        Рассчитать стоимость
      </a>
    </nav>

    <details class="site-header__menu">
      <summary>
        <span>Меню</span>
        <span class="site-header__burger" aria-hidden="true"></span>
      </summary>

      <div class="site-header__menu-panel">
        <nav aria-label="Мобильная навигация">
          <ul role="list">
            {navigation.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="button button--acid" href="/#contacts">Оставить заявку</a>
      </div>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.site-header__menu').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        menu.open = false;
      }
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: 1px solid var(--color-line-dark);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .site-header__inner {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-right: 1px solid var(--color-line-dark);
    border-left: 1px solid var(--color-line-dark);
  }

  .site-header__brand {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 1.15rem;
  }

  .site-header__brand-name {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-header__brand-name strong {
    color: var(--color-acid);
    font-weight: 700;
  }

  .site-header__brand-note {
    padding-left: 1.15rem;
    border-left: 1px solid var(--color-line-dark);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .site-header__desktop {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: clamp(0.1rem, 0.6vw, 0.65rem);
  }

  .site-header__links a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    padding: 0 0.42rem;
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .site-header__links a:hover {
    color: var(--color-acid);
  }

  .site-header__cta {
    min-height: 44px;
    padding-inline: 1.05rem;
    font-size: 0.62rem;
    white-space: nowrap;
  }

  .site-header__menu {
    display: none;
    position: relative;
  }

  .site-header__menu summary {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 0.65rem;
    padding: 0 0.85rem;
    border: 1px solid var(--color-line-dark);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    list-style: none;
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__burger {
    position: relative;
    width: 18px;
    height: 12px;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
  }

  .site-header__burger::after {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
  }

  .site-header__menu-panel {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    display: grid;
    gap: 1rem;
    width: min(360px, calc(100vw - 1.7rem));
    padding: 1rem;
    border: 1px solid var(--color-line-dark);
    background: var(--color-ink);
  }

  .site-header__menu-panel li + li {
    border-top: 1px solid var(--color-line-dark);
  }

  .site-header__menu-panel nav a {
    display: flex;
    min-height: 42px;
    align-items: center;
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  @media (max-width: 1240px) {
    .site-header__desktop {
      display: none;
    }

    .site-header__menu {
      display: block;
    }
  }

  @media (max-width: 620px) {
    .site-header__inner {
      border-right: 0;
      border-left: 0;
    }

    .site-header__brand-note {
      display: none;
    }

    .site-header__brand-name {
      font-size: 1.6rem;
    }
  }
</style>
