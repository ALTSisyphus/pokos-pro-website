---
/**
 * Компактная шапка в логике референса.
 */
const navigation = [
  { href: '/#services', label: 'Услуги' },
  { href: '/#advantages', label: 'Преимущества' },
  { href: '/#works', label: 'Работы' },
  { href: '/#prices', label: 'Цены' },
  { href: '/#service-area', label: 'Где работаем' },
  { href: '/#articles', label: 'Статьи' },
  { href: '/#contacts', label: 'Контакты' },
] as const;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Покос ПРО — главная">
      <span class="site-header__brand-name">Покос <strong>ПРО</strong></span>
      <span class="site-header__brand-note">Профессиональный<br />покос травы</span>
    </a>

    <nav class="site-header__desktop" aria-label="Основная навигация">
      <ul class="site-header__links" role="list">
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>

      <a class="button button--primary site-header__cta" href="/#contacts">
        Оставить заявку
      </a>
    </nav>

    <details class="site-header__menu">
      <summary aria-label="Открыть меню">
        <span>Меню</span>
        <span class="site-header__burger" aria-hidden="true"></span>
      </summary>

      <div class="site-header__menu-panel">
        <nav aria-label="Мобильная навигация">
          <ul role="list">
            {navigation.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="button button--primary" href="/#contacts">Оставить заявку</a>
      </div>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.site-header__menu').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .site-header__inner {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__brand {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 1.35rem;
  }

  .site-header__brand-name {
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .site-header__brand-name strong {
    color: var(--color-primary);
  }

  .site-header__brand-note {
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-heading);
    font-size: 0.66rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .site-header__desktop {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.75rem);
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 0.7vw, 0.8rem);
  }

  .site-header__links a {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    padding: 0 0.55rem;
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 0.74rem;
    font-weight: 600;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .site-header__links a:hover {
    color: var(--color-primary);
  }

  .site-header__cta {
    min-height: 42px;
    padding-inline: 1.4rem;
    white-space: nowrap;
  }

  .site-header__menu {
    display: none;
    position: relative;
  }

  .site-header__menu summary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--color-border-strong);
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__burger {
    position: relative;
    width: 18px;
    height: 12px;
    border-top: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
  }

  .site-header__burger::after {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 2px;
    background: currentColor;
    content: '';
    transform: translateY(-50%);
  }

  .site-header__menu-panel {
    position: absolute;
    top: calc(100% + 13px);
    right: 0;
    display: grid;
    gap: 1.25rem;
    width: min(360px, calc(100vw - 2rem));
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .site-header__menu-panel li + li {
    border-top: 1px solid var(--color-border);
  }

  .site-header__menu-panel nav a {
    display: flex;
    min-height: 44px;
    align-items: center;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (max-width: 1180px) {
    .site-header__desktop {
      display: none;
    }

    .site-header__menu {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .site-header__brand {
      gap: 0;
    }

    .site-header__brand-note {
      display: none;
    }

    .site-header__brand-name {
      font-size: 1.25rem;
    }
  }
</style>
