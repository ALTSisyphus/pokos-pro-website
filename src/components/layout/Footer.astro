---
/** Минималистичный чёрный footer. */
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a class="site-footer__brand" href="/">Покос <strong>ПРО</strong></a>
    <span class="site-footer__copy">© 2026 Все права защищены</span>

    <nav class="site-footer__links" aria-label="Юридическая информация">
      <a href="/privacy">Политика конфиденциальности</a>
      <a href="/personal-data">Согласие на обработку данных</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line-dark);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: auto auto 1fr;
    min-height: 64px;
    align-items: center;
    gap: 2rem;
    border-right: 1px solid var(--color-line-dark);
    border-left: 1px solid var(--color-line-dark);
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .site-footer__brand strong {
    color: var(--color-acid);
  }

  .site-footer__copy,
  .site-footer__links {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .site-footer__copy {
    color: var(--color-muted-dark);
  }

  .site-footer__links {
    display: flex;
    justify-content: flex-end;
    gap: 2rem;
    color: var(--color-muted-dark);
  }

  .site-footer a:hover {
    color: var(--color-acid);
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 0.7rem;
      padding-block: 1.25rem;
      border-right: 0;
      border-left: 0;
    }

    .site-footer__links {
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.55rem;
    }
  }
</style>
