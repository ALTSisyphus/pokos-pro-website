---
/** Компактный подвал, продолжающий модульную сетку страницы. */
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__brand">Покос <strong>ПРО</strong></p>
    <p>© {currentYear} Все права защищены</p>
    <div class="site-footer__legal" aria-label="Юридическая информация">
      <span>Политика конфиденциальности</span>
      <span>Согласие на обработку данных</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-background);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    min-height: 76px;
    border-right: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    padding: 1rem 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .site-footer__brand {
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .site-footer__brand strong {
    color: var(--color-primary);
  }

  .site-footer__legal {
    display: flex;
    justify-content: flex-end;
    gap: clamp(1rem, 3vw, 3rem);
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding-block: 1.4rem;
    }

    .site-footer__legal {
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.35rem;
    }
  }
</style>
