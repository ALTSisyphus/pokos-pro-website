---
/**
 * Подвал сайта.
 *
 * Назначение:
 * - отображать название компании;
 * - завершать структуру страницы;
 * - предоставлять место для контактной,
 *   юридической и дополнительной информации.
 *
 * Компонент предназначен для повторного использования
 * на страницах сайта.
 */

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <!-- Основная информация о компании -->
    <a
      class="site-footer__brand"
      href="/"
      aria-label="Покос ПРО — главная страница"
    >
      <span>Покос</span>
      <strong>ПРО</strong>
    </a>

    <!-- Информация об авторских правах -->
    <p class="site-footer__copyright">
      © {currentYear} Покос ПРО
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-10);

    border-top: 1px solid
      color-mix(
        in srgb,
        var(--color-white) 12%,
        transparent
      );

    background: var(--color-background-dark);
    color: rgba(255, 255, 255, 0.7);
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);

    color: var(--color-white);

    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);

    letter-spacing: var(--letter-spacing-tight);
  }

  .site-footer__brand strong {
    color: var(--color-primary);
  }

  .site-footer__copyright {
    max-width: none;

    font-size: var(--font-size-sm);
  }

  @media (max-width: 600px) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
