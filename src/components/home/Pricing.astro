---
/**
 * Раздел стоимости услуг.
 *
 * Назначение:
 * - познакомить посетителя с принципами формирования цены;
 * - показать основные категории работ;
 * - привести посетителя к запросу точного расчёта стоимости.
 *
 * Компонент используется на главной странице сайта.
 *
 * Конкретные цены будут добавлены после формирования
 * окончательного прайс-листа компании.
 */
---

<section
  id="prices"
  class="section section--soft pricing"
  aria-labelledby="prices-title"
>
  <div class="container">
    <header class="section-heading">
      <h2
        id="prices-title"
        class="section-heading__title"
      >
        Стоимость работ
      </h2>

      <p class="section-heading__description">
        Итоговая стоимость зависит от площади, высоты травы и состояния участка.
      </p>
    </header>

    <div class="grid grid--3 pricing__grid">
      <article class="card pricing__card">
        <h3>
          Обычный покос
        </h3>

        <p>
          Для участков с регулярно обслуживаемой травой.
        </p>
      </article>

      <article class="card pricing__card">
        <h3>
          Высокая трава
        </h3>

        <p>
          Для участков с высокой или густой растительностью.
        </p>
      </article>

      <article class="card pricing__card">
        <h3>
          Расчистка участка
        </h3>

        <p>
          Для запущенных территорий, требующих дополнительных работ.
        </p>
      </article>
    </div>

    <div class="pricing__action">
      <a
        class="button button--primary"
        href="#contacts"
      >
        Рассчитать стоимость
      </a>
    </div>
  </div>
</section>

<style>
  .pricing__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);

    border-top: 4px solid var(--color-primary);
  }

  .pricing__action {
    display: flex;
    justify-content: flex-start;

    margin-top: var(--space-10);
  }

  @media (max-width: 479px) {
    .pricing__action .button {
      width: 100%;
    }
  }
</style>
