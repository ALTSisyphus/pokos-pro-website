---
/**
 * Табличный прайс для правой половины парного блока.
 * TODO: перед публикацией заменить демонстрационные цены на утверждённый прайс.
 */
const prices = [
  ['Обычный покос', 'Покос травы средней высоты', 'от 700 ₽ / сотка'],
  ['Высокая трава', 'Покос высокой травы и сорняка', 'от 1 000 ₽ / сотка'],
  ['Расчистка участка', 'Запущенная растительность и сложные зоны', 'от 1 500 ₽ / сотка'],
] as const;
---

<section id="prices" class="pricing" aria-labelledby="prices-title">
  <div class="pricing__inner">
    <h2 id="prices-title">Стоимость работ</h2>

    <div class="pricing__list">
      {prices.map(([title, description, price]) => (
        <article class="pricing__row">
          <div>
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
          <strong>{price}</strong>
        </article>
      ))}
    </div>

    <div class="pricing__footer">
      <a class="button button--primary" href="#contacts">Рассчитать стоимость</a>
      <p>Точная стоимость зависит от площади, состояния участка и объёма работ.</p>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--color-background);
  }

  .pricing__inner {
    padding: clamp(1.8rem, 3.5vw, 3rem);
  }

  .pricing__list {
    margin-top: 1.1rem;
    border-top: 1px solid var(--color-border);
  }

  .pricing__row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.5rem;
    min-height: 76px;
    border-bottom: 1px solid var(--color-border);
  }

  .pricing__row h3 {
    font-size: 0.9rem;
  }

  .pricing__row p {
    margin-top: 0.2rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .pricing__row > strong {
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .pricing__footer {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.6rem;
  }

  .pricing__footer p {
    max-width: 26ch;
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  @media (max-width: 580px) {
    .pricing__inner {
      padding: 1.5rem 1.35rem;
    }

    .pricing__row {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      padding-block: 0.85rem;
    }

    .pricing__footer {
      grid-template-columns: 1fr;
    }
  }
</style>
