---
const prices = [
  { title: 'Обычный покос', text: 'Покос травы средней высоты', price: 'от 700 ₽ / сотка' },
  { title: 'Высокая трава', text: 'Покос высокой травы и сорняка', price: 'от 1 000 ₽ / сотка' },
  { title: 'Расчистка участка', text: 'Кустарник, поросль, сложные зоны', price: 'от 1 500 ₽ / сотка' },
] as const;
---

<section id="prices" class="pricing" aria-labelledby="prices-title">
  <div class="pricing__inner">
    <header class="section-heading">
      <h2 id="prices-title">Стоимость работ</h2>
      <span class="section-index">/04</span>
    </header>

    <div class="pricing__table">
      {prices.map((item) => (
        <div class="pricing__row">
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
          <strong>{item.price}</strong>
        </div>
      ))}
    </div>

    <div class="pricing__footer">
      <a class="button button--acid" href="#contacts">Рассчитать стоимость</a>
      <p>Точная стоимость зависит от площади, состояния участка и объёма работ.</p>
    </div>
  </div>
</section>

<style>
  .pricing__inner {
    min-height: 390px;
    padding: var(--section-padding);
  }

  .pricing__table {
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .pricing__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    min-height: 58px;
    border-bottom: 1px solid var(--color-line);
  }

  .pricing__row h3 {
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .pricing__row p,
  .pricing__footer p {
    margin-top: 0.2rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .pricing__row strong {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .pricing__footer {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: center;
    margin-top: 1rem;
  }

  .pricing__footer .button {
    min-height: 46px;
    font-size: 0.62rem;
  }

  .pricing__footer p {
    max-width: 31ch;
    margin-top: 0;
  }

  @media (max-width: 620px) {
    .pricing__inner {
      min-height: 0;
      padding: var(--section-padding-mobile);
    }

    .pricing__row {
      align-items: end;
    }

    .pricing__row strong {
      font-size: 0.66rem;
    }

    .pricing__footer {
      grid-template-columns: 1fr;
    }
  }
</style>
