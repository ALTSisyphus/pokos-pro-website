---
/** Превью статей в трёх компактных модулях. */
const articles = [
  {
    icon: '///',
    title: 'Как часто нужно косить траву на участке',
    text: 'Разбираемся, от чего зависит периодичность покоса.',
  },
  {
    icon: '✣',
    title: 'Что делать с высокой травой',
    text: 'Подход к заросшим и давно не обслуживаемым участкам.',
  },
  {
    icon: '⌁',
    title: 'Как подготовить участок к покосу',
    text: 'Короткий чек-лист перед приездом бригады.',
  },
] as const;
---

<section id="articles" class="blog" aria-labelledby="articles-title">
  <div class="blog__inner">
    <h2 id="articles-title">Полезные статьи</h2>

    <div class="blog__grid">
      {articles.map((article) => (
        <article class="blog__card">
          <span class="blog__icon" aria-hidden="true">{article.icon}</span>
          <h3>{article.title}</h3>
          <p>{article.text}</p>
          <a href="/blog">Читать статью →</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .blog {
    background: var(--color-background);
  }

  .blog__inner {
    padding: clamp(1.8rem, 3.5vw, 3rem);
  }

  .blog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1.3rem;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .blog__card {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    padding: 1.25rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .blog__icon {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .blog__card h3 {
    margin-top: 1rem;
    font-size: 0.84rem;
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .blog__card p {
    margin-top: 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .blog__card a {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
  }

  @media (max-width: 620px) {
    .blog__inner {
      padding: 1.5rem 1.35rem;
    }

    .blog__grid {
      grid-template-columns: 1fr;
    }

    .blog__card {
      min-height: 190px;
    }
  }
</style>
