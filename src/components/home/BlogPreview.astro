---
const articles = [
  {
    title: 'Как часто нужно косить траву на участке',
    text: 'От чего зависит периодичность покоса.',
  },
  {
    title: 'Что делать с высокой травой',
    text: 'Подход к давно не обслуживаемым участкам.',
  },
  {
    title: 'Как подготовить участок к покосу',
    text: 'Короткий чек-лист перед приездом бригады.',
  },
] as const;
---

<section id="articles" class="blog-preview" aria-labelledby="articles-title">
  <div class="blog-preview__inner">
    <header class="section-heading">
      <h2 id="articles-title">Полезные статьи</h2>
      <span class="section-index">/07</span>
    </header>

    <div class="blog-preview__grid">
      {articles.map((article) => (
        <article class="blog-preview__card">
          <div class="blog-preview__content">
            <h3>{article.title}</h3>
            <p>{article.text}</p>
            <a href="#">Читать статью →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .blog-preview__inner {
    min-height: 280px;
    padding: var(--section-padding);
  }

  .blog-preview__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .blog-preview__card {
    min-width: 0;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .blog-preview__content {
    padding: 0.8rem;
  }

  .blog-preview__card h3 {
    min-height: 3.1em;
    font-size: 0.82rem;
    line-height: 1.05;
  }

  .blog-preview__card p {
    min-height: 3em;
    margin-top: 0.55rem;
    color: var(--color-text-muted);
    font-size: 0.64rem;
  }

  .blog-preview__card a {
    display: inline-flex;
    margin-top: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (max-width: 620px) {
    .blog-preview__inner {
      min-height: 0;
      padding: var(--section-padding-mobile);
    }

    .blog-preview__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
