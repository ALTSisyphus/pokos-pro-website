---
const works = [
  { number: '01', title: 'Покос дачного участка', meta: 'Участок любой площади' },
  { number: '02', title: 'Расчистка запущенного участка', meta: 'Высокая трава и сорняк' },
  { number: '03', title: 'Покос и вывоз травы', meta: 'Комплексное обслуживание' },
] as const;
---

<section id="works" class="works-preview" aria-labelledby="works-title">
  <div class="works-preview__inner">
    <header class="section-heading">
      <h2 id="works-title">Наши работы</h2>
      <span class="section-index">/03</span>
    </header>

    <div class="works-preview__list">
      {works.map((work) => (
        <a class="works-preview__row" href="#contacts">
          <span>{work.number}</span>
          <strong>{work.title}</strong>
          <small>{work.meta}</small>
          <b>Смотреть →</b>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .works-preview__inner {
    min-height: 300px;
    padding: var(--section-padding);
  }

  .works-preview__list {
    margin-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .works-preview__row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1.35fr) minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    min-height: 55px;
    border-bottom: 1px solid var(--color-line);
    transition: background-color var(--transition-fast);
  }

  .works-preview__row:hover {
    background: var(--color-paper-2);
  }

  .works-preview__row > span,
  .works-preview__row > b,
  .works-preview__row > small {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
  }

  .works-preview__row > span {
    color: var(--color-acid-hover);
    font-weight: 700;
  }

  .works-preview__row > strong {
    font-family: var(--font-display);
    font-size: 0.9rem;
    text-transform: uppercase;
  }

  .works-preview__row > small {
    color: var(--color-text-muted);
  }

  @media (max-width: 620px) {
    .works-preview__inner {
      min-height: 0;
      padding: var(--section-padding-mobile);
    }

    .works-preview__row {
      grid-template-columns: 2rem 1fr auto;
      padding-block: 0.7rem;
    }

    .works-preview__row > small {
      display: none;
    }
  }
</style>
