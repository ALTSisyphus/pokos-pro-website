---
/** География выезда с декоративной инженерной графикой. */
const areas = [
  'Дачные и загородные участки',
  'Ближние районы — по согласованию',
  'Дальние выезды — индивидуально',
] as const;
---

<section id="service-area" class="service-area" aria-labelledby="service-area-title">
  <div class="service-area__inner">
    <div class="service-area__copy">
      <span class="section-kicker" aria-hidden="true"></span>
      <h2 id="service-area-title">Где мы работаем</h2>
      <p>
        Выезжаем на участки в пределах согласованной зоны обслуживания.
        Сообщите адрес — подтвердим возможность и сроки выезда.
      </p>
      <a href="#contacts">Уточнить зону выезда →</a>
    </div>

    <ul class="service-area__list" role="list">
      {areas.map((area) => (
        <li><span aria-hidden="true">⌖</span>{area}</li>
      ))}
    </ul>
  </div>
</section>

<style>
.service-area {
    background: var(--color-background);
  }

  .service-area__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(220px, 0.95fr);
    gap: clamp(1.75rem, 3vw, 3rem);
    align-items: start;
    min-height: 0;
    padding: clamp(2rem, 3vw, 3rem);
  }

  .service-area__copy {
    max-width: 390px;
  }

  .service-area__copy .section-kicker {
    width: fit-content;
    margin-bottom: 0.8rem;
    font-size: 0;
  }

  .service-area__copy p {
    max-width: 360px;
    margin-top: 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
  }

  .service-area__copy a {
    display: inline-flex;
    margin-top: 1rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .service-area__list {
    display: grid;
    gap: 1rem;
    align-self: center;
    margin: 0;
    padding-top: 1.2rem;
  }

  .service-area__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    color: var(--color-heading);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .service-area__list span {
    flex: 0 0 auto;
    color: var(--color-primary);
    font-size: 1.1rem;
    line-height: 1;
  }

  @media (max-width: 1050px) {
    .service-area__inner {
      grid-template-columns: 1fr;
      gap: 1.7rem;
    }

    .service-area__list {
      max-width: 420px;
      padding-top: 0;
    }
  }

  @media (max-width: 580px) {
    .service-area__inner {
      padding: 2rem 1.35rem;
    }
  }
</style>
