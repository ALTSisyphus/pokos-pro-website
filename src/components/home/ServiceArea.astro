---
const areas = [
  'Москва и Московская область',
  'Ближние районы — по согласованию',
  'Дальние выезды — индивидуально',
] as const;
---

<section id="service-area" class="service-area" aria-labelledby="service-area-title">
  <div class="service-area__inner">
    <div class="service-area__copy">
      <header class="section-heading">
        <h2 id="service-area-title">Где мы работаем</h2>
        <span class="section-index">/05</span>
      </header>

      <p>
        Выезжаем на дачные и загородные участки. Возможность и срок выезда
        подтверждаем после уточнения адреса и задачи.
      </p>

      <a href="#contacts">Уточнить зону выезда <span aria-hidden="true">→</span></a>
    </div>

    <div class="service-area__panel">
      <ul role="list">
        {areas.map((area, index) => (
          <li><span aria-hidden="true">0{index + 1}</span>{area}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .service-area__inner {
    display: grid;
    grid-template-columns: 0.95fr 1.15fr;
    min-height: 300px;
  }

  .service-area__copy {
    padding: var(--section-padding);
  }

  .service-area__copy h2 {
    max-width: 8ch;
  }

  .service-area__copy p {
    max-width: 34ch;
    margin-top: 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.76rem;
  }

  .service-area__copy a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .service-area__panel {
    padding: var(--section-padding);
    border-left: 1px solid var(--color-line);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .service-area__panel ul {
    display: grid;
    gap: 1.15rem;
  }

  .service-area__panel li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.7rem;
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .service-area__panel li span {
    color: var(--color-acid);
    font-size: 1rem;
  }

  @media (max-width: 620px) {
    .service-area__inner {
      grid-template-columns: 1fr;
    }

    .service-area__panel {
      min-height: 220px;
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }
  }
</style>
