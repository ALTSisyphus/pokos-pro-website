---
/** Модульная строка услуг по образцу референса. */
const services = [
  {
    number: '01',
    title: 'Покос травы',
    text: 'Покос травы на дачных и загородных участках любой площади.',
  },
  {
    number: '02',
    title: 'Высокая трава',
    text: 'Удаление высокой и густой растительности на сложных участках.',
  },
  {
    number: '03',
    title: 'Расчистка участка',
    text: 'Удаление сорняка и лишней растительности перед дальнейшими работами.',
  },
] as const;
---

<section id="services" class="services" aria-labelledby="services-title">
  <div class="container services__grid">
    <header class="services__intro">
      <span class="section-kicker" aria-hidden="true"></span>
      <h2 id="services-title">Наши услуги</h2>
    </header>

    {services.map((service) => (
      <article class="services__item">
        <span class="services__number">{service.number}</span>
        <h3>{service.title}</h3>
        <p>{service.text}</p>
        <a href="#contacts" aria-label={`Узнать стоимость: ${service.title}`}>→</a>
      </article>
    ))}
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: 0.95fr repeat(3, 1fr);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .services__intro,
  .services__item {
    min-height: 250px;
    padding: clamp(1.6rem, 3vw, 2.5rem);
  }

  .services__intro {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 1rem;
  }

  .services__intro .section-kicker {
    width: fit-content;
    font-size: 0;
  }

  .services__item {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--color-border);
  }

  .services__number {
    margin-bottom: 1.5rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1;
  }

  .services__item p {
    margin-top: 0.8rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .services__item a {
    width: fit-content;
    margin-top: auto;
    padding-top: 1rem;
    color: var(--color-primary);
    font-size: 1.35rem;
    line-height: 1;
  }

  @media (max-width: 980px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .services__item:nth-of-type(2) {
      border-left: 0;
    }

    .services__item:nth-of-type(n + 2),
    .services__intro + .services__item + .services__item {
      border-top: 1px solid var(--color-border);
    }
  }

  @media (max-width: 620px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    .services__intro,
    .services__item {
      min-height: 0;
      padding: 1.5rem 1.35rem;
    }

    .services__item,
    .services__item:nth-of-type(2) {
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }

    .services__item a {
      margin-top: 1rem;
    }
  }
</style>
