---
const services = [
  {
    number: '01',
    title: 'Покос травы',
    text: 'Покос травы на дачных и загородных участках любой площади.',
  },
  {
    number: '02',
    title: 'Высокая трава',
    text: 'Удаление зарослей и высокой травы на сложных и труднодоступных участках.',
  },
  {
    number: '03',
    title: 'Расчистка участка',
    text: 'Удаление сорняка, кустарника и мелколесья. Подготовка территории к дальнейшим работам.',
  },
] as const;
---

<section id="services" class="services" aria-labelledby="services-title">
  <div class="container services__grid">
    <header class="services__intro">
      <div class="section-heading">
        <h2 id="services-title">Услуги</h2>
        <span class="section-index">/01</span>
      </div>
      <p>Основные задачи, с которыми выезжаем на участок.</p>
    </header>

    {services.map((service) => (
      <article class="services__item">
        <span class="services__number">{service.number}</span>
        <h3>{service.title}</h3>
        <p>{service.text}</p>
        <a href="#contacts">Подробнее <span aria-hidden="true">→</span></a>
      </article>
    ))}
  </div>
</section>

<style>
  .services {
    background: var(--color-paper);
  }

  .services__grid {
    display: grid;
    grid-template-columns: 0.9fr repeat(3, 1fr);
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .services__intro,
  .services__item {
    min-height: 215px;
    padding: clamp(1.5rem, 2.4vw, 2.4rem);
  }

  .services__intro p {
    max-width: 22ch;
    margin-top: 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .services__item {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--color-line);
  }

  .services__number {
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 700;
    line-height: 1;
  }

  .services__item h3 {
    margin-top: 0.9rem;
  }

  .services__item p {
    max-width: 28ch;
    margin-top: 0.8rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .services__item a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    margin-top: auto;
    padding-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .services__item a span {
    font-size: 1rem;
    transition: transform var(--transition-fast);
  }

  .services__item a:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr 1fr;
    }

    .services__intro {
      grid-column: 1 / -1;
    }

    .services__item:nth-of-type(1),
    .services__item:nth-of-type(3) {
      border-left: 0;
    }

    .services__item {
      border-top: 1px solid var(--color-line);
    }
  }

  @media (max-width: 620px) {
    .services__grid {
      width: 100%;
      grid-template-columns: 1fr;
      border-right: 0;
      border-left: 0;
    }

    .services__intro,
    .services__item {
      min-height: 0;
      padding: var(--section-padding-mobile);
      border-left: 0;
    }
  }
</style>
