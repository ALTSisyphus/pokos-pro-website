---
/** FAQ в виде строгого аккордеона без карточек. */
const questions = [
  {
    question: 'От чего зависит стоимость?',
    answer: 'От площади, высоты и плотности травы, рельефа и дополнительных работ.',
  },
  {
    question: 'Можно ли заказать срочный выезд?',
    answer: 'Да, если в графике есть свободное окно. Возможность подтверждаем при обращении.',
  },
  {
    question: 'Вы работаете в выходные?',
    answer: 'График выездов согласуется индивидуально при оформлении заявки.',
  },
  {
    question: 'Как подготовить участок к покосу?',
    answer: 'Желательно убрать предметы, которые могут повредить технику или быть скрыты в траве.',
  },
] as const;
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="faq__inner">
    <h2 id="faq-title">Частые вопросы</h2>

    <div class="faq__list">
      {questions.map((item) => (
        <details class="faq__item">
          <summary>
            <span>{item.question}</span>
            <span class="faq__plus" aria-hidden="true">+</span>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--color-background);
  }

  .faq__inner {
    padding: clamp(1.8rem, 3.5vw, 3rem);
  }

  .faq__list {
    margin-top: 1.3rem;
    border: 1px solid var(--color-border);
    border-bottom: 0;
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .faq__item summary {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 58px;
    padding: 0.8rem 1rem;
    color: var(--color-heading);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__plus {
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 1.2rem;
    transition: transform var(--transition-base);
  }

  .faq__item[open] .faq__plus {
    color: var(--color-primary);
    transform: rotate(45deg);
  }

  .faq__item p {
    max-width: 62ch;
    padding: 0 2.5rem 1rem 1rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  @media (max-width: 580px) {
    .faq__inner {
      padding: 1.5rem 1.35rem;
    }
  }
</style>
