---
/** Частые вопросы в виде жёсткого accordion-списка. */
const items = [
  {
    question: 'От чего зависит стоимость?',
    answer: 'От площади, высоты и плотности растительности, рельефа и дополнительных работ.',
  },
  {
    question: 'Можно ли заказать срочный выезд?',
    answer: 'Возможность срочного выезда зависит от загрузки и адреса участка. Уточняем при обращении.',
  },
  {
    question: 'Вы работаете в выходные?',
    answer: 'Дату и время работ согласовываем индивидуально при оформлении заявки.',
  },
  {
    question: 'Как подготовить участок к покосу?',
    answer: 'Сообщите о скрытых препятствиях, коммуникациях и объектах, которые необходимо сохранить.',
  },
] as const;
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="faq__inner">
    <header class="faq__heading">
      <h2 id="faq-title">Частые вопросы</h2>
      <span class="section-index">/06</span>
    </header>

    <div class="faq__list">
      {items.map((item) => (
        <details class="faq__item">
          <summary>
            <span>{item.question}</span>
            <span class="faq__plus" aria-hidden="true">+</span>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__inner {
    min-height: 300px;
    padding: clamp(1.4rem, 2vw, 2rem);
  }

  .faq__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .faq__list {
    margin-top: 1.25rem;
    border: 1px solid var(--color-line);
  }

  .faq__item + .faq__item {
    border-top: 1px solid var(--color-line);
  }

  .faq__item summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: center;
    min-height: 42px;
    padding: 0.55rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__plus {
    font-family: var(--font-body);
    font-size: 1rem;
    transition: transform var(--transition-fast);
  }

  .faq__item[open] .faq__plus {
    transform: rotate(45deg);
  }

  .faq__item p {
    padding: 0 0.75rem 0.8rem;
    color: var(--color-text-muted);
    font-size: 0.74rem;
  }

  @media (max-width: 620px) {
    .faq__inner {
      min-height: 0;
      padding: 1.35rem 1rem;
    }
  }
</style>
