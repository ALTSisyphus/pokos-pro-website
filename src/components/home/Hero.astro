---
/**
 * Первый экран: крупная display-типографика и utility-copy без изображений и декора.
 */
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="container hero__frame">
    <div class="hero__main">
      <div class="hero__headline">
        <span class="section-index">/00</span>
        <h1 id="hero-title">
          <span>Косим.</span>
          <span>Чистим.</span>
          <span>Приводим</span>
          <span class="hero__accent">в порядок.</span>
        </h1>
      </div>

      <div class="hero__offer">
        <p class="hero__lead">
          Покос травы,<br />расчистка и уход<br />за участками
        </p>

        <p class="hero__description">
          Работаем быстро и аккуратно. Подбираем способ работ под состояние
          территории и заранее согласовываем задачу.
        </p>

        <div class="hero__actions">
          <a class="button button--acid" href="#contacts">Оставить заявку</a>
          <a class="button button--paper" href="#prices">Рассчитать стоимость</a>
        </div>
      </div>
    </div>

    <ul class="hero__facts" role="list" aria-label="Принципы работы">
      <li><span aria-hidden="true">01</span><b>Современная техника</b></li>
      <li><span aria-hidden="true">02</span><b>Аккуратная работа</b></li>
      <li><span aria-hidden="true">03</span><b>Выезд по согласованию</b></li>
      <li><span aria-hidden="true">04</span><b>Понятная стоимость</b></li>
    </ul>
  </div>
</section>

<style>
  .hero {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .hero__frame {
    border-right: 1px solid var(--color-line-dark);
    border-left: 1px solid var(--color-line-dark);
  }

  .hero__main {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.75fr);
    min-height: 500px;
  }

  .hero__headline,
  .hero__offer {
    min-width: 0;
  }

  .hero__headline {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 3vw, 3rem);
  }

  .hero__headline .section-index {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    color: var(--color-paper);
    font-size: clamp(5rem, 7.1vw, 8.2rem);
    line-height: 0.86;
    letter-spacing: -0.055em;
  }

  .hero h1 span {
    display: block;
  }

  .hero__accent {
    color: var(--color-acid);
  }

  .hero__offer {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 3vw, 3rem);
    border-left: 1px solid var(--color-line-dark);
  }

  .hero__lead {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.3vw, 2.65rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero__description {
    max-width: 31ch;
    margin-top: 1.5rem;
    color: var(--color-muted-dark);
    font-size: 0.86rem;
  }

  .hero__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__actions .button {
    width: 100%;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    min-height: 72px;
    border-top: 1px solid var(--color-line-dark);
  }

  .hero__facts li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    color: var(--color-paper);
  }

  .hero__facts li + li {
    border-left: 1px solid var(--color-line-dark);
  }

  .hero__facts span,
  .hero__facts strong {
    color: var(--color-acid);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .hero__facts b {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    line-height: 1.35;
    text-transform: uppercase;
  }

  @media (max-width: 1120px) {
    .hero__main {
      grid-template-columns: 1.3fr 0.8fr;
    }

    .hero__headline {
      grid-column: 1;
    }

    .hero__offer {
      grid-column: 2;
    }

    .hero__facts {
      grid-template-columns: repeat(3, 1fr);
    }

    .hero__facts li:nth-child(4) {
      border-top: 1px solid var(--color-line-dark);
      border-left: 0;
    }
  }

  @media (max-width: 760px) {
    .hero__frame {
      width: 100%;
      border-right: 0;
      border-left: 0;
    }

    .hero__main {
      grid-template-columns: 1fr;
    }

    .hero__headline,
    .hero__offer {
      grid-column: 1;
    }

    .hero__headline {
      min-height: 390px;
      padding: 3.2rem 1rem 1.5rem;
    }

    .hero h1 {
      font-size: clamp(4.2rem, 20vw, 6.4rem);
    }

    .hero__offer {
      padding: 1.5rem 1rem;
      border-top: 1px solid var(--color-line-dark);
      border-left: 0;
    }

    .hero__lead {
      font-size: 2rem;
    }

    .hero__facts {
      grid-template-columns: 1fr 1fr;
    }

    .hero__facts li {
      border-top: 1px solid var(--color-line-dark);
    }

    .hero__facts li:nth-child(odd) {
      border-left: 0;
    }
  }
</style>
