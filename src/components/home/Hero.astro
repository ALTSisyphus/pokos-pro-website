---
/**
 * Первый экран главной страницы.
 *
 * Назначение:
 * - кратко сообщить посетителю основную услугу компании;
 * - сформулировать главное ценностное предложение;
 * - привести посетителя к отправке заявки;
 * - обеспечить быстрый переход к разделу с услугами.
 *
 * Компонент используется на главной странице сайта.
 */
---

<section
  id="hero"
  class="hero"
  aria-labelledby="hero-title"
>
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">
        Покос ПРО · уход за участками
      </p>

      <h1 id="hero-title">
        Покос травы и расчистка{' '}<span>участков</span>
      </h1>

      <p class="hero__description">
        Помогаем привести в порядок дачные и загородные территории:
        работаем с обычной, высокой и густой травой, убираем лишнюю
        растительность.
      </p>

      <div class="hero__actions">
        <a
          class="button button--primary"
          href="#contacts"
        >
          Рассчитать стоимость
        </a>

        <a
          class="hero__secondary-link"
          href="#services"
        >
          Посмотреть услуги

          <span aria-hidden="true">→</span>
        </a>
      </div>

      <ul
        class="hero__proof"
        role="list"
        aria-label="Принципы работы"
      >
        <li>Аккуратно к территории</li>
        <li>Понятные условия</li>
        <li>Подход под состояние участка</li>
      </ul>
    </div>

    <aside
      class="hero__work-scope"
      aria-label="Основные направления работ"
    >
      <div class="hero__work-scope-header">
        <p>С чем поможем</p>
        <span aria-hidden="true">ПРО / 01</span>
      </div>

      <ol class="hero__services">
        <li>
          <span aria-hidden="true">01</span>
          <strong>Покос травы</strong>
          <p>Регулярный уход за территорией</p>
        </li>

        <li>
          <span aria-hidden="true">02</span>
          <strong>Высокая трава</strong>
          <p>Работа с густой растительностью</p>
        </li>

        <li>
          <span aria-hidden="true">03</span>
          <strong>Расчистка участка</strong>
          <p>Подготовка территории к дальнейшим работам</p>
        </li>
      </ol>

      <p class="hero__work-scope-note">
        Способ выполнения работ подбирается с учётом особенностей
        и текущего состояния участка.
      </p>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;

    overflow: hidden;

    border-bottom: 1px solid var(--color-border);
    background: var(--color-background-soft);
  }

  .hero::before {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;

    width: max(31vw, 420px);

    border-left: 1px solid var(--color-border);
    background: var(--color-background-muted);

    content: '';

    pointer-events: none;
  }

  .hero__inner {
    position: relative;

    z-index: var(--z-base);

    display: grid;
    grid-template-columns:
      minmax(0, 1.25fr)
      minmax(340px, 0.75fr);
    align-items: center;
    gap: clamp(var(--space-12), 7vw, var(--space-24));

    min-height: 650px;

    padding-block: clamp(var(--space-16), 7vw, var(--space-24));
  }

  .hero__content {
    display: grid;
    justify-items: start;

    max-width: 760px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);

    margin-bottom: var(--space-5);

    color: var(--color-primary);

    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;

    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .hero__eyebrow::before {
    width: 34px;
    height: 3px;

    background: var(--color-primary);

    content: '';
  }

  .hero h1 {
    max-width: 14ch;

    text-wrap: balance;
  }

  .hero h1 span {
    color: var(--color-primary);
  }

  .hero__description {
    max-width: 620px;

    margin-top: var(--space-6);

    color: var(--color-text);
    font-size: clamp(
      1.0625rem,
      0.95rem + 0.45vw,
      1.25rem
    );
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);

    margin-top: var(--space-8);
  }

  .hero__secondary-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);

    min-height: 48px;

    padding-inline: var(--space-2);

    color: var(--color-heading);

    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
  }

  .hero__secondary-link span {
    color: var(--color-primary);
    font-size: var(--font-size-lg);

    transition: transform var(--transition-base);
  }

  .hero__secondary-link:hover {
    color: var(--color-primary);
  }

  .hero__secondary-link:hover span {
    transform: translateX(4px);
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);

    margin-top: var(--space-10);
    padding-top: var(--space-5);

    border-top: 1px solid var(--color-border);
  }

  .hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);

    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .hero__proof li::before {
    width: 7px;
    height: 7px;

    background: var(--color-primary);

    content: '';
  }

  .hero__work-scope {
    position: relative;

    display: grid;
    align-self: stretch;
    align-content: space-between;

    min-height: 470px;

    padding: clamp(var(--space-8), 4vw, var(--space-12));

    overflow: hidden;

    background: var(--color-background-dark);
    color: rgba(255, 255, 255, 0.76);

    box-shadow: var(--shadow-sm);
  }

  .hero__work-scope::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;

    width: 6px;

    background: var(--color-primary);

    content: '';
  }

  .hero__work-scope-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);

    padding-bottom: var(--space-5);

    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .hero__work-scope-header p {
    color: var(--color-white);

    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);

    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .hero__work-scope-header span {
    color: rgba(255, 255, 255, 0.5);

    font-family: var(--font-heading);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-wide);
  }

  .hero__services {
    list-style: none;
  }

  .hero__services li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: var(--space-1) var(--space-4);

    padding-block: var(--space-5);

    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .hero__services li > span {
    grid-row: 1 / span 2;

    color: #a8c9ad;

    font-family: var(--font-heading);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-wide);
  }

  .hero__services strong {
    color: var(--color-white);

    font-family: var(--font-heading);
    font-size: var(--font-size-md);
    line-height: 1.35;
  }

  .hero__services p {
    color: rgba(255, 255, 255, 0.65);

    font-size: var(--font-size-sm);
    line-height: 1.55;
  }

  .hero__work-scope-note {
    margin-top: var(--space-5);

    color: rgba(255, 255, 255, 0.72);

    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  @media (max-width: 960px) {
    .hero::before {
      display: none;
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);

      min-height: auto;

      padding-block: var(--space-16);
    }

    .hero__content {
      max-width: 760px;
    }

    .hero__work-scope {
      min-height: auto;
    }

    .hero__services {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero__services li {
      grid-template-columns: 1fr;

      padding-inline: var(--space-5);

      border-right: 1px solid rgba(255, 255, 255, 0.14);
      border-bottom: 0;
    }

    .hero__services li:first-child {
      padding-left: 0;
    }

    .hero__services li:last-child {
      padding-right: 0;
      border-right: 0;
    }

    .hero__services li > span {
      grid-row: auto;
    }
  }

  @media (max-width: 680px) {
    .hero__inner {
      gap: var(--space-10);

      padding-block: var(--space-12) var(--space-14);
    }

    .hero__eyebrow {
      margin-bottom: var(--space-4);

      font-size: var(--font-size-xs);
      letter-spacing: 0.06em;
    }

    .hero h1 {
      max-width: 13ch;
    }

    .hero__description {
      margin-top: var(--space-5);
    }

    .hero__actions {
      width: 100%;

      margin-top: var(--space-6);
    }

    .hero__actions .button,
    .hero__secondary-link {
      width: 100%;
    }

    .hero__secondary-link {
      justify-content: center;
    }

    .hero__proof {
      gap: var(--space-2) var(--space-4);

      margin-top: var(--space-6);
      padding-top: var(--space-4);
    }

    .hero__work-scope {
      padding: var(--space-6);
    }

    .hero__services {
      display: block;
    }

    .hero__services li {
      grid-template-columns: 28px 1fr;

      padding-inline: 0;

      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }

    .hero__services li > span {
      grid-row: 1 / span 2;
    }

    .hero__work-scope-note {
      margin-top: var(--space-4);
    }
  }
</style>
