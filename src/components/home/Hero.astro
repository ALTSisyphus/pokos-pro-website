---
/**
 * Первый экран главной страницы.
 *
 * Назначение:
 * - кратко сообщить посетителю основную услугу компании;
 * - сформулировать главное ценностное предложение;
 * - привести посетителя к отправке заявки;
 * - обеспечить быстрый переход к разделу с услугами.
 *
 * Компонент используется на главной странице сайта.
 */
---

<section
  id="hero"
  class="hero"
  aria-labelledby="hero-title"
>
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">
        Покос ПРО · уход за участками
      </p>

      <h1 id="hero-title">
        Покос травы и расчистка{' '}<span>участков</span>
      </h1>

      <p class="hero__description">
        Помогаем привести в порядок дачные и загородные территории:
        работаем с обычной, высокой и густой травой, убираем лишнюю
        растительность.
      </p>

      <div class="hero__actions">
        <a
          class="button button--primary"
          href="#contacts"
        >
          Рассчитать стоимость
        </a>

        <a
          class="hero__secondary-link"
          href="#services"
        >
          Посмотреть услуги

          <span aria-hidden="true">→</span>
        </a>
      </div>

      <ul
        class="hero__proof"
        role="list"
        aria-label="Принципы работы"
      >
        <li>Аккуратно к территории</li>
        <li>Понятные условия</li>
        <li>Подход под состояние участка</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;

    overflow: hidden;

    border-bottom: 1px solid var(--color-border);
    background: var(--color-background-soft);
  }

  .hero::before {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;

    width: max(24vw, 320px);

    border-left: 1px solid var(--color-border);
    background: var(--color-background-muted);

    content: '';

    pointer-events: none;
  }

  .hero::after {
    position: absolute;
    top: 50%;
    right: clamp(2rem, 7vw, 7rem);

    width: clamp(140px, 15vw, 220px);
    height: clamp(140px, 15vw, 220px);

    border-top: 1px solid var(--color-border-strong);
    border-right: 1px solid var(--color-border-strong);

    content: '';

    opacity: 0.55;
    pointer-events: none;
    transform: translateY(-50%) rotate(45deg);
  }

  .hero__inner {
    position: relative;

    z-index: var(--z-base);

    display: flex;
    align-items: center;

    min-height: clamp(610px, calc(100svh - var(--header-height)), 760px);

    padding-block: clamp(var(--space-16), 7vw, var(--space-24));
  }

  .hero__content {
    display: grid;
    justify-items: start;

    width: min(100%, 860px);
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);

    margin-bottom: var(--space-5);

    color: var(--color-primary);

    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;

    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
  }

  .hero__eyebrow::before {
    width: 34px;
    height: 3px;

    background: var(--color-primary);

    content: '';
  }

  .hero h1 {
    max-width: 15ch;

    text-wrap: balance;
  }

  .hero h1 span {
    color: var(--color-primary);
  }

  .hero__description {
    max-width: 620px;

    margin-top: var(--space-6);

    color: var(--color-text);
    font-size: clamp(
      1.0625rem,
      0.95rem + 0.45vw,
      1.25rem
    );
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);

    margin-top: var(--space-8);
  }

  .hero__secondary-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);

    min-height: 48px;

    padding-inline: var(--space-2);

    color: var(--color-heading);

    font-family: var(--font-heading);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
  }

  .hero__secondary-link span {
    color: var(--color-primary);
    font-size: var(--font-size-lg);

    transition: transform var(--transition-base);
  }

  .hero__secondary-link:hover {
    color: var(--color-primary);
  }

  .hero__secondary-link:hover span {
    transform: translateX(4px);
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);

    margin-top: var(--space-10);
    padding-top: var(--space-5);

    border-top: 1px solid var(--color-border);
  }

  .hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);

    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .hero__proof li::before {
    width: 7px;
    height: 7px;

    background: var(--color-primary);

    content: '';
  }

  @media (max-width: 1100px) {
    .hero::before,
    .hero::after {
      display: none;
    }

    .hero__inner {
      min-height: auto;

      padding-block: var(--space-16);
    }

    .hero__content {
      max-width: 760px;
    }
  }

  @media (max-width: 680px) {
    .hero__inner {
      padding-block: var(--space-12) var(--space-14);
    }

    .hero__eyebrow {
      margin-bottom: var(--space-4);

      font-size: var(--font-size-xs);
      letter-spacing: 0.06em;
    }

    .hero h1 {
      max-width: 13ch;
    }

    .hero__description {
      margin-top: var(--space-5);
    }

    .hero__actions {
      width: 100%;

      margin-top: var(--space-6);
    }

    .hero__actions .button,
    .hero__secondary-link {
      width: 100%;
    }

    .hero__secondary-link {
      justify-content: center;
    }

    .hero__proof {
      gap: var(--space-2) var(--space-4);

      margin-top: var(--space-6);
      padding-top: var(--space-4);
    }
  }
</style>
