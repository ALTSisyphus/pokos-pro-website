---
/**
 * Первый экран. Двухколоночная композиция максимально приближена к референсу:
 * крупная типографика слева, фирменная модульная геометрия справа.
 */
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__content">
      <h1 id="hero-title">
        Покос травы<br />и расчистка<br /><span>участков</span>
      </h1>

      <p class="hero__description">
        Приводим участки в порядок: убираем высокую траву, сорняки и заросли.
        Работаем быстро, аккуратно и с учётом состояния территории.
      </p>

      <div class="hero__actions">
        <a class="button button--primary" href="#contacts">Рассчитать стоимость</a>
        <a class="hero__secondary" href="#works">
          Посмотреть работы <span aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="hero__proof" role="list" aria-label="Преимущества">
        <li>
          <span class="hero__proof-icon" aria-hidden="true">✓</span>
          <span>Современное<br />оборудование</span>
        </li>
        <li>
          <span class="hero__proof-icon" aria-hidden="true">✓</span>
          <span>Аккуратная<br />работа</span>
        </li>
        <li>
          <span class="hero__clock" aria-hidden="true"></span>
          <span>Оперативный<br />выезд</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
.hero {
    background: var(--color-background);
  }

  .hero__grid {
    display: block;
    min-height: 0;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .hero__content {
    display: flex;
    min-height: clamp(400px, 42vw, 465px);
    width: 100%;
    max-width: 980px;
    flex-direction: column;
    justify-content: center;
    padding:
      clamp(2.5rem, 3.8vw, 3.75rem)
      clamp(2.5rem, 5vw, 5rem);
  }

  .hero h1 {
    max-width: 9ch;
  }

  .hero h1 span {
    color: var(--color-primary);
  }

  .hero__description {
    max-width: 680px;
    margin-top: 1.25rem;
    color: var(--color-heading);
    font-size: clamp(0.95rem, 1.05vw, 1.08rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.55rem;
  }

  .hero__secondary {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 0.8rem;
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .hero__secondary span {
    color: var(--color-primary);
    font-size: 1.15rem;
    transition: transform var(--transition-base);
  }

  .hero__secondary:hover span {
    transform: translateX(4px);
  }

  .hero__proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.35rem;
    width: 100%;
    max-width: 700px;
    margin-top: 1.8rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-border);
  }

  .hero__proof li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    color: var(--color-heading);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .hero__proof-icon,
  .hero__clock {
    display: inline-grid;
    position: relative;
    width: 25px;
    height: 27px;
    flex: 0 0 auto;
    place-items: center;
    border: 1.5px solid var(--color-primary);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .hero__proof-icon {
    clip-path: polygon(
      50% 0,
      92% 15%,
      92% 60%,
      50% 100%,
      8% 60%,
      8% 15%
    );
  }

  .hero__clock {
    border-radius: 50%;
  }

  .hero__clock::before,
  .hero__clock::after {
    position: absolute;
    width: 1.5px;
    background: var(--color-primary);
    content: "";
    transform-origin: bottom center;
  }

  .hero__clock::before {
    top: 6px;
    left: 11px;
    height: 7px;
  }

  .hero__clock::after {
    top: 10px;
    left: 11px;
    height: 6px;
    transform: rotate(125deg);
  }

  @media (max-width: 900px) {
    .hero__content {
      min-height: 500px;
      max-width: none;
      padding:
        3.4rem
        clamp(1.5rem, 6vw, 3rem);
    }
  }

  @media (max-width: 620px) {
    .hero__content {
      min-height: 0;
      padding: 3rem 1.35rem 2.5rem;
    }

    .hero__description {
      margin-top: 1.3rem;
    }

    .hero__actions {
      align-items: stretch;
      margin-top: 1.6rem;
    }

    .hero__actions .button {
      width: 100%;
    }

    .hero__secondary {
      width: fit-content;
    }

    .hero__proof {
      grid-template-columns: 1fr;
      gap: 0.9rem;
      margin-top: 2rem;
    }

    .hero__proof li br {
      display: none;
    }
  }
</style>
