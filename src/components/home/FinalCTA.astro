---
/** Большая зелёная CTA-плоскость с формой, как в нижнем правом блоке референса. */
---

<section id="contacts" class="final-cta" aria-labelledby="contacts-title">
  <div class="final-cta__inner">
    <div class="final-cta__copy">
      <h2 id="contacts-title">Заказать покос травы</h2>
      <p>
        Оставьте заявку — свяжемся с вами, уточним задачу и рассчитаем стоимость.
      </p>

      <ul class="final-cta__facts" role="list">
        <li><span aria-hidden="true">↗</span> Уточним параметры участка</li>
        <li><span aria-hidden="true">✓</span> Согласуем дату и время выезда</li>
      </ul>
    </div>

    <form class="final-cta__form">
      <div class="final-cta__fields">
        <label>
          <span class="visually-hidden">Имя</span>
          <input type="text" name="name" autocomplete="name" placeholder="Имя" />
        </label>
        <label>
          <span class="visually-hidden">Телефон</span>
          <input type="tel" name="phone" autocomplete="tel" placeholder="Телефон" required />
        </label>
      </div>

      <label>
        <span class="visually-hidden">Описание участка и задачи</span>
        <textarea name="message" placeholder="Опишите участок и задачу"></textarea>
      </label>

      <button class="button button--light" type="submit">Отправить заявку</button>
    </form>
  </div>
</section>

<style>
  .final-cta {
    height: 100%;
    background: var(--color-primary);
    color: var(--color-white);
  }

  .final-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    height: 100%;
    min-height: 360px;
    padding: clamp(1.8rem, 3.5vw, 3rem);
  }

  .final-cta h2 {
    color: var(--color-white);
  }

  .final-cta__copy p {
    max-width: 33ch;
    margin-top: 0.9rem;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.8rem;
  }

  .final-cta__facts {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.7rem;
  }

  .final-cta__facts li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
  }

  .final-cta__facts span {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.65);
    font-family: var(--font-heading);
  }

  .final-cta__form {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }

  .final-cta__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .final-cta input,
  .final-cta textarea {
    border-color: rgba(255, 255, 255, 0.48);
    background: var(--color-white);
    color: var(--color-heading);
  }

  .final-cta textarea {
    min-height: 132px;
  }

  .final-cta .button {
    justify-self: start;
    min-width: 190px;
  }

  @media (max-width: 1180px) {
    .final-cta__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 580px) {
    .final-cta__inner {
      padding: 1.5rem 1.35rem;
    }

    .final-cta__fields {
      grid-template-columns: 1fr;
    }

    .final-cta .button {
      width: 100%;
    }
  }
</style>
