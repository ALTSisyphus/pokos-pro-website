---
/**
 * Базовый layout сайта.
 *
 * Назначение:
 * - формировать HTML-оболочку страниц сайта;
 * - задавать язык документа;
 * - подключать глобальные стили;
 * - подключать базовые meta-теги;
 * - устанавливать заголовок страницы;
 * - устанавливать описание страницы;
 * - предоставлять слот для содержимого конкретной страницы.
 *
 * Используется всеми страницами сайта как общая основа документа.
 */

import '../styles/global.css';

interface Props {
  /**
   * Заголовок страницы.
   *
   * Используется в HTML-теге <title>.
   */
  title?: string;

  /**
   * Краткое описание страницы.
   *
   * Используется в meta-теге description.
   */
  description?: string;
}

const {
  title = 'Покос ПРО — профессиональный покос травы',
  description =
    'Профессиональный покос травы на дачных участках. Быстро, аккуратно и по понятной цене.',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content={description}
    />

    <title>{title}</title>
  </head>

  <body>
    <!-- Содержимое конкретной страницы -->
    <slot />
  </body>
</html>
