---
/** Базовый layout сайта. */
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Покос ПРО — профессиональный покос травы',
  description =
    'Покос травы и расчистка дачных и загородных участков. Понятная стоимость, аккуратная работа и выезд по согласованию.',
} = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0b" />

    <Font cssVariable="--font-oswald" />
    <Font cssVariable="--font-roboto" />
    <Font cssVariable="--font-ibm-plex-mono" />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
    <slot />
  </body>
</html>
